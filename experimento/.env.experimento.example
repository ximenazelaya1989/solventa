# Copiar como experimento/.env.experimento en la EC2 solventa-app y
# reemplazar DB_HOST por la IP PRIVADA de la EC2 solventa-db.
DB_HOST=10.0.0.0
DB_PORT=5432
DB_USER=solventa
DB_PASSWORD=solventa
DB_NAME=solventa
# Solo en el entorno desechable del experimento: la API crea las tablas al
# arrancar. En producción se usan migraciones (DB_SYNCHRONIZE=false).
DB_SYNCHRONIZE=true
# Variable controlada: tamaño del pool (semáforo de conexiones a la BD)
DB_POOL_MAX=10
PORT=3000
SUSCRIPCION_UMBRAL_APROBACION=0.7
SUSCRIPCION_UMBRAL_REVISION=0.4
