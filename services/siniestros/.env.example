PORT=3000
SERVICE_NAME=siniestros
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=siniestros_db
DB_SYNCHRONIZE=true
DB_POOL_MAX=10
# RDS exige TLS: true en AWS, false en local
DB_SSL=false
# EXP-006 (H7.2.1): Pagos detras del ALB interno
PAGOS_URL=http://localhost:3000
# EXP-006: reintentos con backoff exponencial + jitter y llave de idempotencia
# (false = prueba de control: un solo intento)
RETRY_IDEMPOTENCY_ENABLED=false
PAGOS_TIMEOUT_MS=3000
RETRY_MAX_ATTEMPTS=10
RETRY_BASE_MS=200
RETRY_MAX_DELAY_MS=8000
RETRY_BUDGET_MS=30000
