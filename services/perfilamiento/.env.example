SERVICE_NAME=perfilamiento
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/perfilamiento_db
REDIS_URL=redis://localhost:6379/0
# EXP-007 (revocacion de consentimiento): apagado por defecto
CONSENT_CHECK_ENABLED=false
CONSENTIMIENTO_URL=http://localhost:18005
CONSENT_CACHE_TTL_S=60
CONSENT_TIMEOUT_S=1.0
# true | false | ruta al certificado autofirmado del ALB
CONSENTIMIENTO_TLS_VERIFY=true
JWT_SECRET=cambiar-en-despliegue
# EXP-009 (Open Finance caido): apagado por defecto
OPEN_FINANCE_ENABLED=false
OPEN_FINANCE_URL=http://localhost:18009
OPEN_FINANCE_TIMEOUT_S=0.12
# EXP-009: tacticas (solo aplican con OPEN_FINANCE_ENABLED=true; apagadas por defecto)
# timeout hacia Open Finance = presupuesto por dependencia (caso 6.1)
CIRCUIT_BREAKER_ENABLED=false
CB_VENTANA=10
CB_TASA_FALLOS=0.5
CB_ABIERTO_S=30
CB_PRUEBAS=3
BULKHEAD_MAX=10
PERFIL_CACHE_MAX_EDAD_S=86400
# endpoints /admin/open-finance/* (solo entorno de experimento)
OPEN_FINANCE_ADMIN_ENABLED=false
