PORT=3000
SERVICE_NAME=pagos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pagos_db
DB_SYNCHRONIZE=true
DB_POOL_MAX=10
# Aurora/RDS exigen TLS: true en AWS, false en local
DB_SSL=false
# EXP-006 (H7.2.1): fallar rapido durante el failover de Aurora
DB_CONNECT_TIMEOUT_MS=2000
DB_QUERY_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
# EXP-006: idempotencia (apagada en la prueba de control)
RETRY_IDEMPOTENCY_ENABLED=false
# EXP-006: pasarela de pagos (sin URL se simula la aprobacion)
PASARELA_URL=
PASARELA_TIMEOUT_MS=2000
# EXP-006: endpoint POST /admin/fallas/caida (solo en el ambiente del experimento)
FAULT_INJECTION_ENABLED=false
FAULT_INJECTION_TOKEN=
