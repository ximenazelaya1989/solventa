PORT=3000
SERVICE_NAME=distribucion-socios
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=socios_db
DB_SYNCHRONIZE=true
DB_POOL_MAX=10
# EXP-010 (HU5.1.1): autorizacion por pertenencia del cliente (apagada por defecto)
JWT_VALIDATION_ENABLED=false
COTIZACION_URL=http://localhost:18001
# client_id de Cognito de cada socio, separados por coma
EXP010_COGNITO_CLIENTES_SOCIO_A=local-socio-a
EXP010_COGNITO_CLIENTES_SOCIO_B=local-socio-b
